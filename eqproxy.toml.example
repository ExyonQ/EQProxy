# Example EQProxy configuration (v0.6).
#
# Validation errors: file, line, field, cause and a fix example.

schema_version = 1

# Drain window on shutdown (SIGINT): live connections may finish.
shutdown_grace = "10s"

[listener.web]
listen = "127.0.0.1:8080"   # IP:PORT (port 0 = ephemeral)
backend = "api"             # reference to a [backend.*] section
mode = "tcp"                # "tcp" (tunnel) or "http" (strict HTTP/1.1)
maxconn = 1024              # concurrent connections; newcomers are refused when full
connect_timeout = "5s"      # connect to the backend
idle_timeout = "60s"        # inactivity per tunnel direction
# mode = "http" only: per-message-phase timeouts
client_header_timeout = "5s"   # request head (client → proxy)
server_header_timeout = "30s"  # response head (backend → proxy)

# TLS termination (A11): optional. Without this section the listener is plain TCP.
#[listener.web.tls]
#cert = "certs/fullchain.pem"  # PEM chain (leaf first)
#key = "certs/privkey.pem"     # PEM private key (PKCS#8/PKCS#1/SEC1)
#alpn = ["http/1.1"]           # offered ALPN (A14); empty = no ALPN
#min_version = "1.2"           # "1.2" (default) or "1.3"
#client_ca = "certs/client-ca.pem"  # mTLS (A15): client certs must chain to this CA

# PROXY protocol v1 reception (B-H9/B-E10): strict front door.
# Only allowlisted origins are accepted and every connection must carry
# a valid PROXY v1 line; anything else is closed without forwarding.
#proxy_receive = true
#proxy_allow = ["10.0.0.0/8", "192.0.2.10"]   # IPs or CIDRs

# Forwarded headers (B-N4, http mode): "off" (default), "append"
# (keep the chain and grow it) or "replace" (drop spoofed hops).
#forwarded_headers = "append"

# Custom answer for the "no server available" class (C9).
#[listener.web.local_response]
#status = 503
#content_type = "text/plain"
#body = "back soon"

# Routing rules (B-H3/B-H4; mode = "http" only): ordered, first match
# wins; the listener's `backend` is the fallback when no rule matches.
# Conditions AND together: host/host_prefix/host_regex (case-insensitive,
# port-free), path/path_prefix/path_regex (literal, no normalization),
# methods, headers (exact/regex/present), ip (CIDR blocks). Exactly one
# action per rule: use_backend, redirect or direct_response (B-N5/B-I6).
#[[listener.web.rules]]
#name = "api-v1"
#path_prefix = "/v1/"
#use_backend = "api"
## Optional rewrite of the forwarded request (only with use_backend):
#[listener.web.rules.rewrite]
#path_prefix_rewrite = "/api/"      # replaces the matched path_prefix ("" strips it)
#host_rewrite = "api.internal"      # exact upstream Host
#
#[[listener.web.rules]]
#name = "moved"
#path = "/old"
#[listener.web.rules.redirect]      # local 3xx; the backend is never contacted
#status = 301                       # 301/302/303/307/308 (default 301)
#location = "https://$host$request_uri"  # $host, $uri, $request_uri
#
#[[listener.web.rules]]
#name = "healthz"
#path = "/healthz"
#[listener.web.rules.direct_response]  # local body; the backend is never contacted
#status = 200
#content_type = "text/plain"
#body = "pong"

[backend.api]
# One server (compat 0.1.0) …
server = "127.0.0.1:9000"
# … or several with weights (B1/B7). `server` and `servers` are mutually exclusive.
#servers = [
#  { addr = "10.0.0.1:9000", weight = 3 },   # weight 0..=256; 0 = drained
#  { addr = "10.0.0.2:9000", weight = 1 },
#]
#balance = "roundrobin"        # Phase 2b: weighted round-robin only
#proxy_protocol = "v1"         # send PROXY protocol v1 to the servers (A9)

#maxqueue = 256            # bounded wait queue when no server is up (B-H7)
#timeout_queue = "500ms"    # max wait in the queue; expired → explicit 503
#retries = 1               # extra dials on connect failure (0..=5; B-H7)
#retry_non_idempotent = true  # opt-in: allow redials for POST & co (off)

# Active health check (B11/B-H6). Absent = all servers operational.
#[backend.api.health_check]
#type = "tcp"      # "tcp" (default) or "http"
#interval = "2s"   # between check cycles
#timeout = "1s"    # per attempt (connect + request + response)
#fall = 3          # consecutive failures → server down
#rise = 2          # consecutive successes → server up
#passive = true    # B-N10: live traffic (5xx / connect failures) also
#                  # feeds fall/rise (only safe with an active checker)
# HTTP checks (type = "http") — one real exchange per probe:
#http_path = "/healthz"
#http_method = "GET"        # or "HEAD"
#http_host = "api.internal" # Host header of the probe
#expect_status = "200-299"  # status codes/ranges accepted
#expect_rstring = "^ok"     # regex matched against the body

# TLS to the servers (A12). Absent = plain TCP.
#[backend.api.tls]
#verify = true               # certificate and name verification (default)
#ca_file = "certs/ca.pem"    # extra CAs (private CAs)
#server_name = "api.internal"  # SNI/verification; defaults to the `addr` host
#alpn = ["http/1.1"]
#min_version = "1.2"
