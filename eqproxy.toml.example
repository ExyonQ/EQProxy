# Ejemplo de configuración de EQProxy (Fase 1).
#
# Errores de validación: archivo, línea, campo, causa y ejemplo de corrección.

schema_version = 1

# Ventana de drenaje al apagar (SIGINT): las conexiones vivas pueden terminar.
shutdown_grace = "10s"

[listener.web]
listen = "127.0.0.1:8080"   # IP:PUERTO (puerto 0 = efímero)
backend = "api"             # referencia a una sección [backend.*]
maxconn = 1024              # conexiones simultáneas; al llenarse se rechaza
connect_timeout = "5s"      # conexión al backend
idle_timeout = "60s"        # inactividad por dirección del túnel

[backend.api]
server = "127.0.0.1:9000"   # Fase 1: un servidor; balanceo en Fase 2
